<Window
    x:Class="SandSound.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SandSound"
    Width="1100"
    Height="780"
    MinWidth="760"
    MinHeight="620"
    WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#202020" BorderBrush="#343434" BorderThickness="0,0,0,1" Padding="20,13">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="30" Height="30" CornerRadius="9" Background="#F4BE62">
          <TextBlock Text="S" Foreground="#201A12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="SandSound" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="macOS" Classes="muted" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border x:Name="MessageBanner" DockPanel.Dock="Top" IsVisible="False" Margin="18,14,18,0" Padding="12,9" CornerRadius="9" Background="#3B3120">
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    </Border>

    <TabControl x:Name="Navigation" Margin="18,12,18,18">
      <TabItem Header="Download">
        <ScrollViewer>
          <StackPanel Margin="24,26,24,42" Spacing="22" MaxWidth="950" HorizontalAlignment="Stretch">
            <StackPanel Spacing="7">
              <TextBlock Text="Your media, ready when you are." Classes="title" />
              <TextBlock Text="Turn videos and playlists into a portable offline library." Classes="muted" FontSize="15" />
            </StackPanel>

            <Border Classes="card">
              <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ToggleButton x:Name="UrlModeButton" Content="URL" IsChecked="True" Click="UrlMode_Click" />
                  <ToggleButton x:Name="SearchModeButton" Content="Search" Click="SearchMode_Click" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox x:Name="SourceBox" Watermark="Paste a YouTube video or playlist URL" KeyDown="SourceBox_KeyDown" />
                  <Button x:Name="InspectButton" Grid.Column="1" Content="Inspect" Classes="accent" Click="InspectButton_Click" Padding="22,8" />
                </Grid>
                <ProgressBar x:Name="DiscoveryProgress" IsIndeterminate="True" IsVisible="False" Height="3" />
              </StackPanel>
            </Border>

            <StackPanel x:Name="SearchResultsSection" IsVisible="False" Spacing="10">
              <TextBlock Text="Search results" Classes="section" />
              <ItemsControl x:Name="SearchResultsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Margin="0,0,0,8" Padding="14">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Download" Click="SearchDownload_Click" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border x:Name="PreviewCard" Classes="card" IsVisible="False">
              <StackPanel Spacing="15">
                <StackPanel Spacing="4">
                  <TextBlock x:Name="PreviewTitle" Classes="section" TextWrapping="Wrap" />
                  <TextBlock x:Name="PreviewSubtitle" Classes="muted" />
                </StackPanel>
                <ListBox x:Name="PlaylistList" SelectionMode="Multiple" MaxHeight="300" IsVisible="False">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="5" Spacing="2">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="5">
                    <TextBlock Text="Format" Classes="muted" FontSize="12" />
                    <ComboBox x:Name="FormatBox" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="Quality" Classes="muted" FontSize="12" />
                    <ComboBox x:Name="QualityBox" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="Add to queue" Classes="accent" VerticalAlignment="Bottom" Click="QueueButton_Click" Padding="18,8" />
                </Grid>
                <Button x:Name="ResyncPlaylistButton" Content="Resync playlist" HorizontalAlignment="Left" IsVisible="False" Click="ResyncPlaylist_Click" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Queue">
        <Grid Margin="24" RowDefinitions="Auto,*" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Download queue" Classes="title" />
              <TextBlock Text="Downloads continue while you browse the app." Classes="muted" />
            </StackPanel>
            <Button Grid.Column="1" Content="Open downloads" Click="OpenDownloads_Click" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Cancel all" Click="CancelAll_Click" VerticalAlignment="Center" />
          </Grid>
          <ListBox x:Name="DownloadsList" Grid.Row="1">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Margin="0,0,0,9" Padding="15">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="muted" />
                      </Grid>
                      <ProgressBar Value="{Binding Progress}" Maximum="100" />
                      <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Cancel" Click="CancelItem_Click" IsEnabled="{Binding CanCancel}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="Library">
        <Grid Margin="24" RowDefinitions="Auto,220,Auto,*" RowSpacing="13">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="Library" Classes="title" />
              <TextBlock Text="A portable record of downloads stored beside SandSound." Classes="muted" />
            </StackPanel>
            <Button Grid.Column="1" Content="Clear history" Click="ClearHistory_Click" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="Playlist history" Classes="section" />
            <ListBox x:Name="PlaylistHistoryList">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Margin="0,0,0,6" Padding="13">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Open" Click="OpenPlaylistHistory_Click" />
                      <Button Grid.Column="2" Content="Resync" Click="ResyncPlaylistHistory_Click" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          <TextBlock Grid.Row="2" Text="Download history" Classes="section" />
          <ListBox x:Name="HistoryList" Grid.Row="3">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Margin="0,0,0,7" Padding="14">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <ScrollViewer>
          <StackPanel Margin="24,24,24,42" Spacing="18" MaxWidth="760" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
              <TextBlock Text="Settings" Classes="title" />
              <TextBlock Text="Every setting stays in the portable Data folder." Classes="muted" />
            </StackPanel>
            <Border Classes="card">
              <StackPanel Spacing="14">
                <TextBlock Text="Storage" Classes="section" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                  <TextBox x:Name="DownloadDirectoryBox" IsReadOnly="True" Watermark="Download folder" />
                  <Button Grid.Column="1" Content="Choose…" Click="ChooseDownloadFolder_Click" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                  <TextBox x:Name="CookieFileBox" IsReadOnly="True" Watermark="Optional Netscape cookie file" />
                  <Button Grid.Column="1" Content="Choose…" Click="ChooseCookieFile_Click" />
                </Grid>
                <CheckBox x:Name="PlaylistFoldersCheck" Content="Create a folder for each playlist" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="13">
                <TextBlock Text="Experience" Classes="section" />
                <TextBlock Text="Theme" Classes="muted" FontSize="12" />
                <ComboBox x:Name="ThemeBox" />
                <TextBlock Text="Concurrent downloads" Classes="muted" FontSize="12" />
                <NumericUpDown x:Name="ConcurrencyBox" Minimum="1" Maximum="8" Increment="1" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Portable runtime" Classes="section" />
                <TextBlock x:Name="RuntimeStatusText" TextWrapping="Wrap" Classes="muted" />
                <TextBlock x:Name="PortablePathText" TextWrapping="Wrap" FontFamily="Menlo" FontSize="12" Classes="muted" />
                <Button Content="Check for updates" Click="CheckUpdates_Click" HorizontalAlignment="Left" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
            <Button Content="Save settings" Classes="accent" Click="SaveSettings_Click" HorizontalAlignment="Left" Padding="18,9" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
